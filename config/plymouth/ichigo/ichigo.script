# Boot screen (docs/desktop.md, Login; colors are the system tokens from docs/theme.md,
# Color: system). A fixed photo as background (background.png, the same as the lock's
# lock-background.png) and one password field with its dots; no logo. After the password
# the field stays and its dots give way to a loading bar inside it (a fill growing left
# to right on a track, driven by time) until Plymouth quits. No text at all: every part
# is a picture, so nothing depends on fonts. The lock is a different screen (hyprlock).
# Sizes are physical pixels for the 1920 x 1080 panel, placed from the screen centre:
# field centre 300 below it (y 840); the bar is centred in the field.
# Pictures: background.png (1920 x 1080, scaled to the screen), field.png,
# field-error.png, password-dot.png, bar-track.png, bar-fill-left.png,
# bar-fill-middle.png, bar-fill-right.png; the SVG sources sit next to all but the
# photo.

# Black, shown only if background.png is missing.
Window.SetBackgroundTopColor(0, 0, 0);                  # bar #000000
Window.SetBackgroundBottomColor(0, 0, 0);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;
center_y = screen_y + screen_h / 2;

# The photo, behind everything.
bg_image = Image("background.png").Scale(screen_w, screen_h);
bg = Sprite(bg_image);
bg.SetPosition(screen_x, screen_y, -100);

# Password field, hidden until cryptsetup asks. field_error sits on top of it while a
# wrong password is shown.
field_image = Image("field.png");
field_center_y = center_y + 300;
field_x = center_x - field_image.GetWidth() / 2;
field_y = field_center_y - field_image.GetHeight() / 2;
field = Sprite(field_image);
field.SetPosition(field_x, field_y, 20);
field.SetOpacity(0);
field_error = Sprite(Image("field-error.png"));
field_error.SetPosition(field_x, field_y, 21);
field_error.SetOpacity(0);

# Dots: radius 7, 30 px centre to centre, the row centred in the field.
dot_image = Image("password-dot.png");
dot_step = 30;
dot_max = Math.Int((field_image.GetWidth() - 56 - dot_image.GetWidth()) / dot_step) + 1;
dot_y = field_center_y - dot_image.GetHeight() / 2;
dots_made = 0;

# Loading bar, centred in the field: track 296 x 4 (line) and a fill (label) that grows
# from the track's left end. Above the field, below the dots; hidden until the password
# is given. The fill is a left cap (2 x 4), a middle scaled to the needed width and a
# right cap (2 x 4), so the rounded ends never stretch. The middle runs 1 px under each
# cap, which hides the soft edge that scaling leaves on its last column.
track_image = Image("bar-track.png");
fill_left_image = Image("bar-fill-left.png");
fill_right_image = Image("bar-fill-right.png");
fill_middle_image = Image("bar-fill-middle.png");
track_w = track_image.GetWidth();
cap_w = fill_left_image.GetWidth();
track_x = center_x - track_w / 2;
bar_y = field_center_y - track_image.GetHeight() / 2;
track = Sprite(track_image);
track.SetPosition(track_x, bar_y, 24);
track.SetOpacity(0);
fill_left = Sprite(fill_left_image);
fill_left.SetPosition(track_x, bar_y, 26);
fill_left.SetOpacity(0);
fill_right = Sprite(fill_right_image);
fill_right.SetPosition(track_x, bar_y, 26);
fill_right.SetOpacity(0);
fill_middle = Sprite();
fill_middle.SetPosition(track_x + cap_w / 2, bar_y, 25);
fill_middle.SetOpacity(0);

# Timing: the refresh callback runs 50 times a second (20 ms a frame).
# Field: 250 ms (13 frames), starting 150 ms (8 frames) after the theme starts. Swap
# after the password: the dots fade out while the bar fades in, 200 ms (10 frames); on a
# wrong password the bar fades out the same way. Fades ease out on
# cubic-bezier(0.16, 1, 0.3, 1). The field never fades out. Bar fill, driven by time
# (no boot progress arrives while LUKS unlocks): fraction = 0.92 * (1 - exp(-t / 1.5)),
# t in seconds since the password was given; about 45% at 1 s, 80% at 3 s, 87% at
# 4.5 s, then it holds near 92%. The script has no exp, so fill_rest holds
# exp(-t / 1.5) and is multiplied by fill_step = exp(-0.02 / 1.5) each frame. Plymouth
# quitting fills the whole track. Wrong password: 1.2 s (60 frames). No breathing.
field_start = 8;
field_frames = 13;
swap_frames = 10;
error_frames = 60;
fill_step = 0.9867551618071957;
fill_top = 0.92;

frame = 0;           # frames since the theme started
asking = 0;          # cryptsetup is waiting for the password
answered = 0;        # a password was given and no new prompt has come yet
bullets_now = 0;
swap_frame = 0;      # 0 = dots shown, swap_frames = bar shown
fill_rest = 1;       # exp(-t / 1.5): 1 when the password is given, toward 0 after
fill_w = 0;          # fill width now drawn, whole px
error_left = 0;      # frames left of the wrong password border

fun bezier(t, a, b) {
  return 3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
}

fun settle(x) {
  if (x <= 0) {
    return 0;
  }
  if (x >= 1) {
    return 1;
  }
  lo = 0;
  hi = 1;
  for (i = 0; i < 16; i++) {
    mid = (lo + hi) / 2;
    if (bezier(mid, 0.16, 0.3) < x) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  return bezier((lo + hi) / 2, 1, 1);
}

fun show_dots(count, opacity) {
  if (count > global.dot_max) {
    count = global.dot_max;
  }
  while (global.dots_made < count) {
    global.dots[global.dots_made] = Sprite(global.dot_image);
    global.dots_made++;
  }
  left = global.center_x - ((count - 1) * global.dot_step + global.dot_image.GetWidth()) / 2;
  for (i = 0; i < global.dots_made; i++) {
    if (i < count) {
      global.dots[i].SetPosition(left + i * global.dot_step, global.dot_y, 30);
      global.dots[i].SetOpacity(opacity);
    } else {
      global.dots[i].SetOpacity(0);
    }
  }
}

# The field's opacity: its own fade, 150 ms after the theme starts.
fun field_opacity() {
  return settle((global.frame - global.field_start) / global.field_frames);
}

# Sets the fill to w px from the track's left end. The middle is scaled again only when
# the width changes by a whole pixel. Below two caps' width (4 px) nothing is shown.
fun set_fill(w) {
  w = Math.Int(w + 0.5);
  if (w > global.track_w) {
    w = global.track_w;
  }
  if (w == global.fill_w) {
    return;
  }
  global.fill_w = w;
  if (w >= 2 * global.cap_w) {
    middle_h = global.fill_middle_image.GetHeight();
    global.fill_middle.SetImage(global.fill_middle_image.Scale(w - global.cap_w, middle_h));
    global.fill_right.SetX(global.track_x + w - global.cap_w);
  }
}

# Back to an empty bar, as before a password.
fun reset_fill() {
  global.fill_rest = 1;
  set_fill(0);
}

# Draws the field, dots and bar for the current state; called every frame and on each
# key press.
fun draw() {
  if (global.asking || global.answered) {
    o = field_opacity();
    global.field.SetOpacity(o);
    if (global.asking && global.error_left > 0) {
      global.field_error.SetOpacity(o);
    } else {
      global.field_error.SetOpacity(0);
    }
    # Dots and bar swap places: one fades out while the other fades in.
    b = settle(global.swap_frame / global.swap_frames);
    if (global.answered) {
      show_dots(global.bullets_now, o * (1 - b));
    } else {
      show_dots(global.bullets_now, o);
    }
    global.track.SetOpacity(b);
    if (global.fill_w >= 2 * global.cap_w) {
      f = b;
    } else {
      f = 0;
    }
    global.fill_left.SetOpacity(f);
    global.fill_middle.SetOpacity(f);
    global.fill_right.SetOpacity(f);
  }
}

fun refresh_callback() {
  global.frame++;
  if (global.error_left > 0) {
    global.error_left--;
  }
  if (global.answered) {
    if (global.swap_frame < global.swap_frames) {
      global.swap_frame++;
    }
    global.fill_rest = global.fill_rest * global.fill_step;
    set_fill(global.track_w * global.fill_top * (1 - global.fill_rest));
  } else if (global.swap_frame > 0) {
    global.swap_frame--;
    if (global.swap_frame == 0) {
      reset_fill();
    }
  }
  draw();
}

fun password_callback(prompt, bullets) {
  # A new prompt after a password was given means the password was wrong: the bar
  # fades out and goes back to empty, the error border shows for 1.2 s and the dots
  # start again from none.
  if (global.answered) {
    global.answered = 0;
    global.error_left = global.error_frames;
  }
  global.asking = 1;
  global.bullets_now = bullets;
  draw();
}

# Called when the prompt ends (password given) and also once at the start of boot,
# before any prompt: the bar only follows a prompt, and each time it starts empty.
fun normal_callback() {
  if (global.asking) {
    global.answered = 1;
    reset_fill();
  }
  global.asking = 0;
}

# Plymouth is quitting: the fill takes the whole track.
fun quit_callback() {
  set_fill(global.track_w);
  draw();
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetQuitFunction(quit_callback);
