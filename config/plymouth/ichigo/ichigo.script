# Boot screen, Light Solid (docs/desktop.md, Login; colors from docs/theme.md).
# The Mori crest (ichimonji ni mitsuboshi) and one password field with its dots. After the
# password the field fades and the word "loading" takes its place, breathing until the
# desktop opens. No other text unless systemd sends a message. Crest and word are pictures
# (kamon.png, loading.png): the boot screen runs before the system fonts are available.
# Sizes are physical pixels for the 1080p panel (the desktop's 1.25 scale is applied by
# hand: the lock's 290 x 42 field becomes 362 x 52).
# Crest centre at 39% of the height, field centre 250 px below it.

Window.SetBackgroundTopColor(0.965, 0.965, 0.973);      # bar #f6f6f8
Window.SetBackgroundBottomColor(0.965, 0.965, 0.973);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;

# The crest, its centre at 39% of the height. It fades in (see refresh_callback).
crest_image = Image("kamon.png");
crest = Sprite(crest_image);
crest_center_y = screen_y + screen_h * 0.39;
crest.SetPosition(center_x - crest_image.GetWidth() / 2, crest_center_y - crest_image.GetHeight() / 2, 10);
crest.SetOpacity(0);

# Password field, hidden until cryptsetup asks; its centre 250 px below the crest's.
field_center_y = crest_center_y + 250;
field_image = Image("entry.png");
field = Sprite(field_image);
field_y = field_center_y - field_image.GetHeight() / 2;
field.SetPosition(center_x - field_image.GetWidth() / 2, field_y, 20);
field.SetOpacity(0);

# "loading", in the field's place once the password is given.
loading_image = Image("loading.png");
loading = Sprite(loading_image);
loading.SetPosition(center_x - loading_image.GetWidth() / 2, field_center_y - loading_image.GetHeight() / 2, 20);
loading.SetOpacity(0);

bullet_image = Image("bullet.png");
bullet_gap = 5;
bullet_step = bullet_image.GetWidth() + bullet_gap;
bullet_max = Math.Int((field_image.GetWidth() - 32) / bullet_step);
bullet_y = field_y + field_image.GetHeight() / 2 - bullet_image.GetHeight() / 2;
dots_made = 0;

# One line under the field for systemd messages (wrong password and the like).
message = Sprite();
message.SetPosition(center_x, field_y + field_image.GetHeight() + 20, 30);

fun show_dots(count, opacity) {
  if (count > global.bullet_max) {
    count = global.bullet_max;
  }
  while (global.dots_made < count) {
    global.dots[global.dots_made] = Sprite(global.bullet_image);
    global.dots_made++;
  }
  left = global.center_x - (count * global.bullet_step - global.bullet_gap) / 2;
  for (i = 0; i < global.dots_made; i++) {
    if (i < count) {
      global.dots[i].SetPosition(left + i * global.bullet_step, global.bullet_y, 30);
      global.dots[i].SetOpacity(opacity);
    } else {
      global.dots[i].SetOpacity(0);
    }
  }
}

# Fades: 300 ms on cubic-bezier(0.16, 1, 0.3, 1). The refresh callback runs 50 times
# a second, so 15 frames. The field appears just after the crest has settled.
# Breathing: 2 s per cycle (100 frames), opacity between 0.4 and 1.
fade_frames = 15;
breath_frames = 100;
frame = 0;
asking = 0;          # cryptsetup is waiting for the password
answered = 0;        # a password was given at least once: show "loading" when not asking
bullets_now = 0;
out_frame = 0;       # frames since the password was given

fun bezier(t, a, b) {
  return 3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
}

fun settle(x) {
  lo = 0;
  hi = 1;
  for (i = 0; i < 16; i++) {
    mid = (lo + hi) / 2;
    if (bezier(mid, 0.16, 0.3) < x) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  return bezier((lo + hi) / 2, 1, 1);
}

fun show_field() {
  if (global.asking && global.frame >= global.fade_frames) {
    global.field.SetOpacity(1);
    show_dots(global.bullets_now, 1);
    global.loading.SetOpacity(0);
  } else if (!global.asking && !global.answered) {
    global.field.SetOpacity(0);
    show_dots(0, 0);
  }
}

# After the password: the field and its dots fade out while "loading" fades in over the
# same 15 frames, then "loading" breathes from full opacity (cosine, so no jump).
fun show_loading() {
  global.out_frame++;
  if (global.out_frame <= global.fade_frames) {
    e = settle(global.out_frame / global.fade_frames);
    global.field.SetOpacity(1 - e);
    show_dots(global.bullets_now, 1 - e);
    global.loading.SetOpacity(e);
  } else {
    t = (global.out_frame - global.fade_frames) / global.breath_frames;
    global.loading.SetOpacity(0.7 + 0.3 * Math.Cos(2 * Math.Pi * t));
  }
}

fun refresh_callback() {
  if (global.frame < global.fade_frames) {
    global.frame++;
    global.crest.SetOpacity(settle(global.frame / global.fade_frames));
    if (global.frame == global.fade_frames) {
      show_field();
    }
  }
  if (global.answered && !global.asking) {
    show_loading();
  }
}

fun password_callback(prompt, bullets) {
  global.asking = 1;
  global.bullets_now = bullets;
  show_field();
}

# Called when the prompt ends (password given) and also once at the start of boot,
# before any prompt: "loading" only follows a prompt.
fun normal_callback() {
  if (global.asking) {
    global.answered = 1;
    global.out_frame = 0;
  }
  global.asking = 0;
  show_field();
}

fun message_callback(text) {
  image = Image.Text(text, 0.431, 0.431, 0.451, 1);     # secondary #6e6e73
  global.message.SetImage(image);
  global.message.SetX(global.center_x - image.GetWidth() / 2);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetMessageFunction(message_callback);
