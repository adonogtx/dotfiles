# Boot screen, matcha (docs/desktop.md, Login; colors from docs/theme.md, Color: boot and
# lock). The mitsuuroko, one password field with its dots, and after the password a bar
# of three segments in the field's place. No text at all: every part is a picture, so
# nothing depends on fonts. The lock is a different screen (hyprlock).
# Sizes are physical pixels for the 1920 x 1080 panel, placed from the screen centre:
# logo centre 99 above it (y 441), field and bar centre 300 below it (y 840).
# Pictures: boot-logo.png, field.png, field-error.png, password-dot.png, bar-track.png,
# bar-fill.png; the SVG sources sit next to them.

Window.SetBackgroundTopColor(0.086, 0.102, 0.082);      # background #161a15
Window.SetBackgroundBottomColor(0.086, 0.102, 0.082);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;
center_y = screen_y + screen_h / 2;

# The mitsuuroko. It fades in (see refresh_callback).
logo_image = Image("boot-logo.png");
logo = Sprite(logo_image);
logo.SetPosition(center_x - logo_image.GetWidth() / 2, center_y - 99 - logo_image.GetHeight() / 2, 10);
logo.SetOpacity(0);

# Password field, hidden until cryptsetup asks. field_error sits on top of it while a
# wrong password is shown.
field_image = Image("field.png");
field_center_y = center_y + 300;
field_x = center_x - field_image.GetWidth() / 2;
field_y = field_center_y - field_image.GetHeight() / 2;
field = Sprite(field_image);
field.SetPosition(field_x, field_y, 20);
field.SetOpacity(0);
field_error = Sprite(Image("field-error.png"));
field_error.SetPosition(field_x, field_y, 21);
field_error.SetOpacity(0);

# Dots: radius 7, 30 px centre to centre, the row centred in the field.
dot_image = Image("password-dot.png");
dot_step = 30;
dot_max = Math.Int((field_image.GetWidth() - 56 - dot_image.GetWidth()) / dot_step) + 1;
dot_y = field_center_y - dot_image.GetHeight() / 2;
dots_made = 0;

# The bar: three segments 164 x 12, 18 apart (528 wide), centred where the field was.
track_image = Image("bar-track.png");
fill_image = Image("bar-fill.png");
segment_w = track_image.GetWidth();
segment_gap = 18;
bar_left = center_x - (3 * segment_w + 2 * segment_gap) / 2;
bar_y = field_center_y - track_image.GetHeight() / 2;
for (i = 0; i < 3; i++) {
  track[i] = Sprite(track_image);
  track[i].SetPosition(bar_left + i * (segment_w + segment_gap), bar_y, 20);
  track[i].SetOpacity(0);
  fill[i] = Sprite(fill_image);
  fill[i].SetPosition(bar_left + i * (segment_w + segment_gap), bar_y, 21);
  fill[i].SetOpacity(0);
}

# Timing: the refresh callback runs 50 times a second (20 ms a frame).
# Logo: 400 ms (20 frames). Field: 250 ms (13 frames), starting 150 ms (8 frames) after
# the logo. Field to bar: 200 ms (10 frames). Wrong password: 1.2 s (60 frames).
# Ease out on cubic-bezier(0.16, 1, 0.3, 1). No breathing.
# Bar loop, driven by time, not by boot progress (Plymouth gets none while LUKS
# unlocks): segment n lights at (n - 1) x 400 ms with a 200 ms fade; at 1.2 s all three
# fade out over 200 ms; the bar stays empty 200 ms; the loop starts again at 1.6 s.
logo_frames = 20;
field_start = 8;
field_frames = 13;
swap_frames = 10;
error_frames = 60;
segment_frames = 20;
fade_frames = 10;
loop_frames = 80;

frame = 0;           # frames since the theme started
asking = 0;          # cryptsetup is waiting for the password
answered = 0;        # a password was given and no new prompt has come yet
bullets_now = 0;
swap_frame = 0;      # frames since the password was given
error_left = 0;      # frames left of the wrong password border
loop_frame = 0;      # frames since the bar loop started, 0 to loop_frames - 1

fun bezier(t, a, b) {
  return 3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
}

fun settle(x) {
  if (x <= 0) {
    return 0;
  }
  if (x >= 1) {
    return 1;
  }
  lo = 0;
  hi = 1;
  for (i = 0; i < 16; i++) {
    mid = (lo + hi) / 2;
    if (bezier(mid, 0.16, 0.3) < x) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  return bezier((lo + hi) / 2, 1, 1);
}

fun show_dots(count, opacity) {
  if (count > global.dot_max) {
    count = global.dot_max;
  }
  while (global.dots_made < count) {
    global.dots[global.dots_made] = Sprite(global.dot_image);
    global.dots_made++;
  }
  left = global.center_x - ((count - 1) * global.dot_step + global.dot_image.GetWidth()) / 2;
  for (i = 0; i < global.dots_made; i++) {
    if (i < count) {
      global.dots[i].SetPosition(left + i * global.dot_step, global.dot_y, 30);
      global.dots[i].SetOpacity(opacity);
    } else {
      global.dots[i].SetOpacity(0);
    }
  }
}

# How lit segment i (0 to 2) is at this point of the loop, 0 to 1.
fun segment_level(i) {
  t = global.loop_frame;
  clear_start = 3 * global.segment_frames;
  if (t >= clear_start) {
    return 1 - settle((t - clear_start) / global.fade_frames);
  }
  return settle((t - i * global.segment_frames) / global.fade_frames);
}

fun show_bar(opacity) {
  for (i = 0; i < 3; i++) {
    global.track[i].SetOpacity(opacity);
    global.fill[i].SetOpacity(opacity * segment_level(i));
  }
}

# The field's opacity while asking: its own fade, 150 ms after the logo starts.
fun field_opacity() {
  return settle((global.frame - global.field_start) / global.field_frames);
}

# Draws the field, dots and bar for the current state; called every frame and on each
# key press.
fun draw() {
  if (global.asking) {
    o = field_opacity();
    global.field.SetOpacity(o);
    show_dots(global.bullets_now, o);
    if (global.error_left > 0) {
      global.field_error.SetOpacity(o);
    } else {
      global.field_error.SetOpacity(0);
    }
    show_bar(0);
  } else if (global.answered) {
    # After the password: the field and its dots fade out while the bar fades in.
    e = settle(global.swap_frame / global.swap_frames);
    global.field.SetOpacity(1 - e);
    global.field_error.SetOpacity(0);
    show_dots(global.bullets_now, 1 - e);
    show_bar(e);
  }
}

fun refresh_callback() {
  global.frame++;
  if (global.frame <= global.logo_frames) {
    global.logo.SetOpacity(settle(global.frame / global.logo_frames));
  }
  if (global.error_left > 0) {
    global.error_left--;
  }
  if (global.answered) {
    if (global.swap_frame < global.swap_frames) {
      global.swap_frame++;
    }
    global.loop_frame++;
    if (global.loop_frame >= global.loop_frames) {
      global.loop_frame = 0;
    }
  }
  draw();
}

fun password_callback(prompt, bullets) {
  # A new prompt after a password was given means the password was wrong: show the
  # error border for 1.2 s; the dots start again from none.
  if (global.answered) {
    global.answered = 0;
    global.error_left = global.error_frames;
  }
  global.asking = 1;
  global.bullets_now = bullets;
  draw();
}

# Called when the prompt ends (password given) and also once at the start of boot,
# before any prompt: the bar only follows a prompt.
fun normal_callback() {
  if (global.asking) {
    global.answered = 1;
    global.swap_frame = 0;
    global.loop_frame = 0;
  }
  global.asking = 0;
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
