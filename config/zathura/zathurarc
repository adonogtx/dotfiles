# ~/.config/zathura/zathurarc · Dark Solid chrome, page untouched
set font                  "IBM Plex Sans 11"
set guioptions            "s"
set window-title-basename true
set selection-clipboard   clipboard
set page-padding          8
set scroll-step           80
set adjust-open           width

set default-bg            "#1c1c1e"
set default-fg            "#f5f5f7"
set statusbar-bg          "#2a2a2d"
set statusbar-fg          "#98989d"
set inputbar-bg           "#1f1f21"
set inputbar-fg           "#f5f5f7"
set notification-bg       "#1f1f21"
set notification-fg       "#f5f5f7"
set notification-error-bg "#ff453a"
set notification-error-fg "#ffffff"
set highlight-color       "rgba(10,132,255,0.35)"
set highlight-active-color "rgba(10,132,255,0.6)"
set completion-bg         "#1f1f21"
set completion-fg         "#98989d"
set completion-highlight-bg "#0a84ff"
set completion-highlight-fg "#ffffff"

set recolor               false
set recolor-lightcolor    "#1c1c1e"
set recolor-darkcolor     "#f5f5f7"
map <C-r> toggle_recolor
