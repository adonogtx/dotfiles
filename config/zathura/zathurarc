# ~/.config/zathura/zathurarc · Light Solid chrome, page untouched
set font                  "IBM Plex Sans 11"
set guioptions            "s"
set window-title-basename true
set selection-clipboard   clipboard
set page-padding          8
set scroll-step           80
set adjust-open           width

set default-bg            "#ececf0"
set default-fg            "#1d1d1f"
set statusbar-bg          "#ffffff"
set statusbar-fg          "#6e6e73"
set inputbar-bg           "#ffffff"
set inputbar-fg           "#1d1d1f"
set notification-bg       "#ffffff"
set notification-fg       "#1d1d1f"
set notification-error-bg "#d70015"
set notification-error-fg "#ffffff"
set highlight-color       "rgba(0,122,255,0.35)"
set highlight-active-color "rgba(0,122,255,0.6)"
set completion-bg         "#ffffff"
set completion-fg         "#6e6e73"
set completion-highlight-bg "#007aff"
set completion-highlight-fg "#ffffff"

set recolor               false
set recolor-lightcolor    "#1c1c1e"
set recolor-darkcolor     "#f5f5f7"
# Ctrl + R: night mode in the old Dark Solid values (docs/theme.md, night)
map <C-r> toggle_recolor
