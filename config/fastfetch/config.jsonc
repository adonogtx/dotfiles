{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Gruvbox bands: green, yellow, orange, red, purple, aqua (docs/theme.md, Logo bands)
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/do.txt",
    "color": {
      "1": "38;2;184;187;38",
      "2": "38;2;250;189;47",
      "3": "38;2;254;128;25",
      "4": "38;2;251;73;52",
      "5": "38;2;211;134;155",
      "6": "38;2;142;192;124"
    },
    "padding": { "right": 5 }
  },
  "display": {
    "separator": "  ",
    "color": { "output": "38;2;235;219;178" },
    "key": { "width": 8 }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;2;235;219;178", "at": "38;2;250;189;47", "host": "38;2;211;134;155" } },
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/fetch.sh date" },
    "break",
    { "type": "os", "key": "os", "keyColor": "38;2;184;187;38", "format": "{name} {arch}" },
    { "type": "kernel", "key": "kernel", "keyColor": "38;2;250;189;47", "format": "{release}" },
    { "type": "wm", "key": "wm", "keyColor": "38;2;250;189;47", "format": "{pretty-name} {version}" },
    { "type": "shell", "key": "shell", "keyColor": "38;2;250;189;47", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "term", "keyColor": "38;2;254;128;25", "format": "{pretty-name} {version}" },
    "break",
    { "type": "command", "key": "cpu", "keyColor": "38;2;254;128;25", "text": "~/.config/fastfetch/fetch.sh cpu" },
    { "type": "memory", "key": "mem", "keyColor": "38;2;251;73;52", "format": "{used} / {total}" },
    { "type": "disk", "key": "disk", "keyColor": "38;2;251;73;52", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "bat", "keyColor": "38;2;251;73;52", "format": "{capacity}" },
    { "type": "uptime", "key": "up", "keyColor": "38;2;211;134;155", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    "break",
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/fetch.sh phrase" },
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/fetch.sh meaning" }
  ]
}
