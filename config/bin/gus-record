#!/usr/bin/env bash
# gus-record: first call picks a region and starts recording, second call stops.
set -euo pipefail
if pgrep -x wf-recorder >/dev/null; then
  pkill -INT -x wf-recorder
  notify-send --app-name=Record "Recording saved" "media/videos/recordings"
  exit 0
fi
dir="$HOME/media/videos/recordings"
mkdir -p "$dir"
geometry="$(slurp)" || exit 0
notify-send --app-name=Record "Recording" "Press Super + Shift + R to stop"
exec wf-recorder -g "$geometry" -f "$dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
