[global]
    monitor = 0
    follow = mouse
    width = 340
    height = 110
    origin = top-right
    offset = 12x40
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#504945"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = Lilex Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = off
    sticky_history = yes
    history_length = 20
    browser = firefox
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false
    force_xwayland = false
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1d2021"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 4

[urgency_normal]
    background = "#1d2021"
    foreground = "#ebdbb2"
    frame_color = "#83a598"
    timeout = 7

[urgency_critical]
    background = "#1d2021"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    timeout = 0
