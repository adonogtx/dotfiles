# zsh · gus
# No oh my zsh: the prompt comes from Starship, the two plugins come straight from pacman.

# Anything machine specific (for example lines from your old .zshrc) goes in ~/.zshrc.local
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

export EDITOR=nvim
export PATH="$HOME/.local/bin:$PATH"

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_dups hist_ignore_space hist_reduce_blanks

# Completion
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Up and down arrows search history by what you already typed
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# eza instead of ls, same colors as yazi
export EZA_COLORS="di=38;2;125;174;163:ex=38;2;169;182;101:*.java=38;2;231;138;78:*.xml=38;2;231;138;78:*.yaml=38;2;211;134;155:*.yml=38;2;211;134;155:*.md=38;2;212;190;152:*.org=38;2;212;190;152:*.jpg=38;2;211;134;155:*.jpeg=38;2;211;134;155:*.png=38;2;211;134;155:*.mp4=38;2;137;180;130:*.mkv=38;2;137;180;130:*.pdf=38;2;234;105;98:*.zip=38;2;216;166;87:*.gz=38;2;216;166;87:*.7z=38;2;216;166;87:*.rar=38;2;216;166;87"
alias ls='eza --icons=auto --group-directories-first'
alias ll='eza -l --icons=auto --git --group-directories-first'
alias la='eza -la --icons=auto --git --group-directories-first'
alias lt='eza --tree --level=2 --icons=auto'

# y opens yazi and, on quit, leaves the shell in the folder you were browsing
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# Optional tools, loaded only if installed
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Plugins
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5a524c'

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_HIGHLIGHT_STYLES[command]='fg=#a9b665'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#a9b665'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#a9b665'
ZSH_HIGHLIGHT_STYLES[function]='fg=#a9b665'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#ea6962'
ZSH_HIGHLIGHT_STYLES[path]='fg=#d4be98,underline'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#7daea3'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#7daea3'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#d8a657'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#d8a657'

# Prompt
eval "$(starship init zsh)"

# >>> gus rituals >>>
# The first terminal of the day opens with the opening ritual. Set GUS_NO_RITUAL=1 to skip it.
if [[ -o interactive && -z "${GUS_NO_RITUAL:-}" && ! -e "${XDG_STATE_HOME:-$HOME/.local/state}/gus/opened-$(date +%F)" ]] \
   && (( $(date +%H) >= 5 )) && command -v day >/dev/null; then
  day open
fi
# <<< gus rituals <<<
