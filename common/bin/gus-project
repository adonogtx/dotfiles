#!/usr/bin/env bash
# gus-project NAME
# A new backend study project in ~/dev/backend/projects/NAME: git, Java 21 through mise,
# and its own Postgres in Docker. Then open it in IntelliJ.
set -euo pipefail
name="${1:?Usage: gus-project NAME}"
dir="$HOME/dev/backend/projects/$name"
[[ -e "$dir" ]] && { echo "Already exists: $dir" >&2; exit 1; }
templates="$(dirname "$(readlink -f "$0")")/../share/gus/templates/backend"
mkdir -p "$dir"
cp -r "$templates/." "$dir/"
sed -i "s/POSTGRES_DB: app/POSTGRES_DB: ${name//-/_}/" "$dir/compose.yaml"
printf '# %s\n\nStart the database: docker compose up -d\n' "$name" > "$dir/README.md"
git -C "$dir" init -q -b main
command -v mise >/dev/null && (cd "$dir" && mise trust -q && mise install -q) || true
echo "Created $dir"
echo "  cd $dir && docker compose up -d"
echo "  Spring Initializr in IntelliJ: File, New, Project, Spring Boot, into this folder"
