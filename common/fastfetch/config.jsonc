{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/do.txt",
    "color": { "1": "38;2;169;182;101", "2": "38;2;216;166;87", "3": "38;2;231;138;78", "4": "38;2;234;105;98", "5": "38;2;211;134;155", "6": "38;2;125;174;163" },
    "padding": { "right": 5 }
  },
  "display": {
    "separator": "  ",
    "color": { "output": "38;2;212;190;152" },
    "key": { "width": 8 }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;2;169;182;101", "at": "38;2;216;166;87", "host": "38;2;211;134;155" } },
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/zen.sh date" },
    "break",
    { "type": "os", "key": "OS", "keyColor": "38;2;169;182;101", "format": "{name} {arch}" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "38;2;216;166;87", "format": "{release}" },
    { "type": "wm", "key": "WM", "keyColor": "38;2;216;166;87", "format": "{pretty-name} {version}" },
    { "type": "shell", "key": "SHELL", "keyColor": "38;2;216;166;87", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "TERM", "keyColor": "38;2;231;138;78", "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "PKGS", "keyColor": "38;2;231;138;78", "format": "{all}" },
    "break",
    { "type": "command", "key": "CPU", "keyColor": "38;2;234;105;98", "text": "~/.config/fastfetch/zen.sh cpu" },
    { "type": "memory", "key": "MEM", "keyColor": "38;2;234;105;98", "format": "{used} / {total}" },
    { "type": "disk", "key": "DISK", "keyColor": "38;2;234;105;98", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery", "key": "BAT", "keyColor": "38;2;211;134;155", "format": "{capacity}" },
    { "type": "uptime", "key": "UP", "keyColor": "38;2;211;134;155", "format": "{?days}{days}d {?}{hours}h {minutes}m" },
    "break",
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/zen.sh phrase" },
    { "type": "command", "key": " ", "text": "~/.config/fastfetch/zen.sh meaning" }
  ]
}
