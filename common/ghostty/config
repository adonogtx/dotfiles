# Ghostty · gus
# The second font-family is the fallback that provides the kamon glyph (U+E900).
# Check the exact family name of your font with: fc-list | grep -i gus

font-family = JetBrainsMono Nerd Font
font-family = gus
font-size = 12

theme = gus-gruvbox
background-opacity = 1

window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-decoration = none

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

mouse-hide-while-typing = true
confirm-close-surface = false
