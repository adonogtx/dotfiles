#!/usr/bin/env bash
# gus-power: lock, suspend, close the day, log out, reboot or shut down.
choice="$(printf '%s\n' "Lock" "Suspend" "Close the day" "Log out" "Reboot" "Shut down" \
  | fuzzel --dmenu --prompt "› " --lines 6 --width 24)" || exit 0
case "$choice" in
  "Lock")          loginctl lock-session ;;
  "Suspend")       systemctl suspend ;;
  "Close the day") ghostty --class=gus.ritual -e day close ;;
  "Log out")       hyprctl dispatch exit ;;
  "Reboot")        systemctl reboot ;;
  "Shut down")     systemctl poweroff ;;
esac
