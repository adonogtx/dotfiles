#!/usr/bin/env bash
set -u

interface="$(
    ip -o route show default 2>/dev/null |
        awk 'NR == 1 { print $5 }'
)"

if [[ -z "$interface" ]]; then
    printf 'off\n'
elif [[ -d "/sys/class/net/$interface/wireless" ]] || [[ "$interface" == wl* ]]; then
    printf 'wifi\n'
else
    printf 'eth\n'
fi
