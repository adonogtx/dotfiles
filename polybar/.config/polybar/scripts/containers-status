#!/usr/bin/env bash
set -u

if ! command -v docker >/dev/null 2>&1; then
    printf '\n'
    exit 0
fi

containers="$(
    timeout 3s docker ps -q 2>/dev/null ||
        true
)"

if [[ -z "$containers" ]]; then
    printf '\n'
    exit 0
fi

count="$(
    awk 'NF { count++ } END { print count + 0 }' <<<"$containers"
)"

printf 'ctr %d\n' "$count"
