#!/usr/bin/env bash
set -Eeuo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/polybar"
state_file="$state_dir/pomodoro.state"
lock_file="$state_dir/pomodoro.lock"

focus_seconds=1500
break_seconds=300

mkdir -p "$state_dir"

exec 9>"$lock_file"
flock -x 9

mode="idle"
running=0
remaining="$focus_seconds"
started=0
left="$remaining"

load_state() {
    if [[ -r "$state_file" ]]; then
        IFS='|' read -r mode running remaining started \
            < "$state_file" || true
    fi
}

save_state() {
    printf '%s|%s|%s|%s\n' \
        "$mode" \
        "$running" \
        "$remaining" \
        "$started" \
        > "$state_file"
}

send_notification() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a pomodoro "$1" "$2"
}

change_phase() {
    local now
    now="$(date +%s)"

    if [[ "$mode" == "focus" ]]; then
        mode="break"
        remaining="$break_seconds"
        send_notification \
            "pomodoro" \
            "pausa de 5 minutos"
    else
        mode="focus"
        remaining="$focus_seconds"
        send_notification \
            "pomodoro" \
            "foco por 25 minutos"
    fi

    running=1
    started="$now"
    left="$remaining"
    save_state
}

refresh_time() {
    local now elapsed

    left="$remaining"

    if (( running == 1 )); then
        now="$(date +%s)"
        elapsed=$((now - started))
        left=$((remaining - elapsed))

        if (( left <= 0 )); then
            change_phase
        fi
    fi
}

load_state

case "${1:-status}" in
    toggle)
        if [[ "$mode" == "idle" ]]; then
            mode="focus"
            running=1
            remaining="$focus_seconds"
            started="$(date +%s)"
        elif (( running == 1 )); then
            refresh_time
            remaining="$left"
            running=0
            started=0
        else
            running=1
            started="$(date +%s)"
        fi

        save_state
        ;;

    skip)
        if [[ "$mode" == "idle" ]]; then
            mode="focus"
        fi

        change_phase
        ;;

    reset)
        rm -f "$state_file"
        ;;

    status)
        if [[ "$mode" == "idle" ]]; then
            printf '\n'
            exit 0
        fi

        refresh_time

        minutes=$((left / 60))
        seconds=$((left % 60))

        if (( running == 0 )); then
            label="停止"
            color="#928374"
        elif [[ "$mode" == "focus" ]]; then
            label="集中"
            color="#fabd2f"
        else
            label="休憩"
            color="#83a598"
        fi

        printf '%%{F%s}%s %02d:%02d%%{F-}\n' \
            "$color" \
            "$label" \
            "$minutes" \
            "$seconds"
        ;;

    *)
        printf 'uso: %s {status|toggle|skip|reset}\n' "$0" >&2
        exit 1
        ;;
esac
