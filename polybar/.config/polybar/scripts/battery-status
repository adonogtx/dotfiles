#!/usr/bin/env bash
set -Eeuo pipefail

battery=""
ac_online=0

for candidate in /sys/class/power_supply/BAT*; do
    [[ -d "$candidate" ]] || continue
    battery="$candidate"
    break
done

[[ -n "$battery" ]] || exit 0
[[ -r "$battery/capacity" ]] || exit 0
[[ -r "$battery/status" ]] || exit 0

for candidate in /sys/class/power_supply/*; do
    [[ -r "$candidate/type" ]] || continue
    [[ "$(<"$candidate/type")" == "Mains" ]] || continue
    [[ -r "$candidate/online" ]] || continue

    if [[ "$(<"$candidate/online")" == "1" ]]; then
        ac_online=1
        break
    fi
done

capacity="$(<"$battery/capacity")"

if (( ac_online )); then
    printf 'pwr %s%%\n' "$capacity"
else
    printf 'bat %s%%\n' "$capacity"
fi
